SET TALK OFF

USE O:\DAT\GPO1\486\DAT
STORE ALLTRIM(CLIENTE) TO CLNTE
CLOSE TABLES

STORE LEFT(DTOC(DATE()),2) TO MM
STORE RIGHT(LEFT(DTOC(DATE()),5),2) TO DD
MESSAGEBOX("Selecciona la ruta para guardar respaldo del DAT: "+CLNTE," AVISO")
RDIR = GETDIR("O:\RESPALDOS\")
RUTA = RDIR+CLNTE+MM+DD

USE O:\Asigna\gen_resp\abcd									&& LLAMA LA BASE DONDE ESTAN LAS LETRAS

DO WHILE .T.

	IF EOF( )
		EXIT
	ENDIF

	STORE ALLTRIM(letra) TO lttr

	IF FILE (RUTA+lttr+'.DBF') = .F. THEN 					&& GENERA RESPALDO SI NO EXISTE |DAT+LETRA|
		USE O:\DAT\GPO1\486\DAT
		COPY TO RUTA+lttr+'.DBF' FOXPLUS
		MESSAGEBOX("Se ha creado un respaldo del DAT en "+RUTA+lttr+'.DBF.'," AVISO")
		EXIT
	ENDIF

SKIP

ENDDO 

CLOSE DATABASES

