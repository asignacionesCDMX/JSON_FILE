SET CENTURY on
SET SAFETY OFF
SET DATE AMERICAN
SET HOURS TO 24

IF MESSAGEBOX('¿DESEAS ACTUALIZAR MORA?',1)=1

	USE O:\PRG\MEXGPO1\asi486\eti486 EXCLUSIVE
	COPY TO O:\PRG\MEXGPO1\asi486\ETI486_2&&RESPALDO
	CLOSE TABLES
	
	MESSAGEBOX('SELECCIONA TU BASE CON (CUENTA2 O FOLIO)|MORA EN CSV')
	USE O:\PRG\MEXGPO1\asi486\PASOETI486 EXCLUSIVE
	ZAP
	APPEND FROM ? CSV
	CLOSE TABLES
	
*!*		USE O:\PRG\MEXGPO1\asi486\PASOETI486
*!*		REPLACE FOLIO WITH CUENTA2 ALL
*!*		CLOSE TABLES
	
	USE O:\PRG\MEXGPO1\asi486\PASOETI486
	UPDATE O:\PRG\MEXGPO1\asi486\PASOETI486 SET CUENTA2 = A.CUENTA2 FROM O:\DAT\GPO1\486\DAT A WHERE VAL(A.FOLIO) = VAL(PASOETI486.VALIDADOR)
	CLOSE TABLES
	USE O:\PRG\MEXGPO1\asi486\PASOETI486
	UPDATE O:\PRG\MEXGPO1\asi486\PASOETI486 SET CUENTA2 = A.CUENTA2 FROM O:\DAT\GPO1\486\DAT A WHERE VAL(A.CUENTA) = VAL(PASOETI486.VALIDADOR) AND EMPTY(PASOETI486.CUENTA2)
	BROWSE
	CLOSE TABLES
	
	USE O:\PRG\MEXGPO1\asi486\PASOETI486 EXCLUSIVE
	DELETE FROM O:\PRG\MEXGPO1\asi486\PASOETI486 WHERE EMPTY(CUENTA2)
	PACK
	CLOSE TABLES
	
	USE O:\PRG\MEXGPO1\asi486\PASOETI486
	UPDATE O:\PRG\MEXGPO1\asi486\PASOETI486 SET MORA='' WHERE MORA='-'
	BROWSE
	CLOSE TABLES
	
	USE O:\PRG\MEXGPO1\asi486\eti486 EXCLUSIVE
	COUNT TO X
	CLOSE TABLES
	
	IF X>0 THEN
		CD O:\PRG\MEXGPO1\asi486
		DELETE FROM eti486 WHERE CUENTA2 IN (SELECT CUENTA2 FROM PASOETI486)
		CLOSE TABLES
		PACK ETI486
		CLOSE TABLES
	ENDIF
	
	USE O:\PRG\MEXGPO1\asi486\eti486 EXCLUSIVE
	APPEND FROM O:\PRG\MEXGPO1\asi486\PASOETI486
	
	IF MESSAGEBOX('DESEAS ACTUALIZAR LOS SALDOS?',1)=1
		CD O:\PRG\MEXGPO1\ASI486
		DO ASI486
		MESSAGEBOX('SE ACTUALIZARON LOS SALDOS; SUBELOS, MANDA EVIDENCIA Y PIDE DAT')
	ELSE
		MESSAGEBOX('CANCELASTE LOS SALDOS',16)
	ENDIF
	
ENDIF
CLOSE TABLES