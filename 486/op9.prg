PACK
DELETE FOR LNTEL<10
PACK
DELETE FOR SUBSTR(TEL1,1,5)='00000'
PACK
DELETE FOR TEL1='1000000000'
PACK
DELETE FOR TEL1='9999999999'
PACK
DELETE FOR TEL1='0999999999'
PACK
CLOSE ALL

