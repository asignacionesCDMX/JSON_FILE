** ELIMINA BASURA DE TEL1
USE o:\DAT\GPO1\486\TELPAS
REPLACE TELO  WITH STRTRAN(TELO," ","") ALL
REPLACE TELO  WITH STRTRAN(TELO,"-","") ALL
REPLACE TEL1  WITH RIGHT(ALLTRIM(TELO),10) ALL
DELETE FOR VAL(TEL1)=0
PACK
DELETE FOR ISDIGIT(TEL1) =.F.
PACK
DELETE FOR SUBSTR(TEL1,1,1)='/'
PACK
