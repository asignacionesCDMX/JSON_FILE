SET SAFETY OFF
SET CENTURY	ON
SET DATE AMERICAN
SET HOURS TO 24
CLOSE ALL

CD O:\PRG\MEXGPO1\ASI486\ACT_PHONE
CD ..

******CONTEO DE TELSAN******
USE TELSAN
COUNT TO CNTC
CLOSE TABLES

******CONTEO DE TELS EN QUEJAS******
USE ELIMINADOS_TELBAJ
COUNT TO QUEJAS
CLOSE TABLES

******BITACORA*********
CD ACT_PHONE
USE BITAC
ZAP
APPEND BLANK
REPLACE QRY WITH "INSERT INTO RCVRY.JSP_VALIDADOR_TELEFONOS (CLIENTE, TOTAL_TELS, TELS_QUEJAS, INICIO, FECHA) VALUES ('486', "+ ALLTRIM(STR(CNTC)) +", "+ ALLTRIM(STR(QUEJAS)) +", TO_CHAR(SYSDATE, 'HH24:MI:SS'), SYSDATE);"
APPEND BLANK
REPLACE QRY WITH "COMMIT;"
APPEND BLANK
REPLACE QRY WITH "EXIT;"
APPEND BLANK
REPLACE QRY WITH "QUIT"
COPY TO BITAC.SQL SDF
CLOSE TABLES

USE O:\DAT\GPO1\486\reg_serv
LOCATE FOR campo2='SACASIG'
STORE qry TO MEX
STORE qry2 TO LOD
CLOSE TABLES

	BITAC = MEX+"BITAC.SQL"
	DEL1 = MEX+"borra.sql"
	ADD1 = LOD+"LOAD_ORACLE.CTL"
	ACTUALIZA = MEX+"ACTUALIZA_PHONE.SQL"
	
	RUN &BITAC
	RUN &DEL1
	RUN &ADD1
	IF MESSAGEBOX('REVISA QUE LA TABLA JSP_TAB_TEL_REMESA_486 TENGA LA INFORMACION',1) = 1
		RUN &ACTUALIZA
	ENDIF
