&&AUTOR: JOSEPH ALBERTO
&&FECHA DE CREACIÓN: 13/06/2022
&&FUNCIONA A PARTIR DE LA FECHA: 13/06/2022
CLOSE TABLES
SET SAFETY OFF
SET CENTURY on
SET DATE AMERICAN
SET HOURS TO 24
CLEAR

IF MESSAGEBOX('DESEAS CORRER ETIQUETAS DE 486',1)=1 THEN

	MESSAGEBOX('SELECCIONA TU BASE CON CUENTA2 Y ETIQUETAS EN DBF')
	USE O:\DAT\GPO1\486\PASO486
	ZAP
	APPEND FROM ?
	MESSAGEBOX('REVISA TU BASE')
	BROWSE
	CLOSE TABLES
	
	IF MESSAGEBOX('¿ES CORRECTA LA INFORMACION?',1)=1 THEN
	
		CD O:\prg\gpo1\486
		DO respaldo2

		&&GENERA ARRAY DE VARIABLES
		DIMENSION TABLAS(14)
		TABLAS[1]='SALDO1'
		TABLAS[2]='SALDO2'
		TABLAS[3]='SALDO3'
		TABLAS[4]='RIESGO'
		TABLAS[5]='PVS'
		TABLAS[6]='TIPO'
		TABLAS[7]='CAPITAL'
		TABLAS[8]='SEGMENTO'
		TABLAS[9]='PAG_MIN'
		TABLAS[10]='ETIQUETA'
		TABLAS[11]='TRAMO'
		TABLAS[12]='SEG'
		TABLAS[13]='SDO_VDO' 
		TABLAS[14]='NOMBRE2' && eti LEYENDA

		CD O:\DAT\GPO1\486
		FOR EACH COLUMNA IN TABLAS
			
			SELECT CUENTA, &COLUMNA FROM O:\DAT\GPO1\486\PASO486 WHERE NOT EMPTY(&COLUMNA) INTO CURSOR S
			COUNT TO V
			CLOSE TABLES
			
			IF V>0
				&&SELECCIONA CADA ETIQUETA Y CREA UNA TABLA SIEMPRE QUE NO ESTE VACIO EL CAMPO
				SELECT CUENTA, &COLUMNA FROM O:\DAT\GPO1\486\PASO486 INTO CURSOR S
				COPY TO O:\DAT\GPO1\486\C&COLUMNA
				CLOSE TABLES
				
				&&ACTUALIZA EN EL DAT LOS REGISTROS QUE EXTRAEMOS ANTERIORMENTE
				USE DAT
				UPDATE DAT SET &COLUMNA=B.&COLUMNA FROM C&COLUMNA B WHERE DAT.CUENTA=B.CUENTA
				CLOSE TABLES
			ENDIF
			
		ENDFOR
		
		&&REVISAMOS QUE LAS ETIQUETAS SE HAYAN REALIZADO DE MANERA CORRECTA
		MESSAGEBOX('REVISA QUE EL ETIQUETADO SEA CORRECTO C:')
		SELECT CUENTA, SALDO1, SALDO2, SALDO3, RIESGO, PVS, TIPO, CAPITAL, SDO_VDO, SEGMENTO, PAG_MIN, ETIQUETA, TRAMO, SEG, NOMBRE2 FROM DAT WHERE CUENTA IN (SELECT CUENTA FROM O:\DAT\GPO1\486\PASO486)
		CLOSE TABLES
		
		IF MESSAGEBOX('¿ES CORRECTO EL ETIQUETADO? CORRERAN SALDOS',1)=1 THEN
			CD o:\prg\mexgpo1\asi486
			DO asi486
			MESSAGEBOX('SE ACTUALIZARON SALDOS, SUBELOS Y MANDA EVIDENCIA')
		ELSE
			MESSAGEBOX('CANCELASTE LOS SALDOS')
		ENDIF
				
	ENDIF

ENDIF
